# ------------------------------------------------------------------
# Half-Marathon Tracker — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# Generate the two secrets below with: ./scripts/gen_keys.sh
# ------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tracker

# --- Security (REQUIRED) ---
# openssl rand -hex 32
JWT_SECRET=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Set to false after you've created your account to lock down registration.
ALLOW_REGISTRATION=true

# Public URL the app is reached at (used for Strava OAuth callback + CORS).
PUBLIC_BASE_URL=https://tracker.example.com

# Host port for local-network access via the Pi's IP (http://<pi-ip>:WEB_PORT).
# Avoid 80/443 on OMV — its own web UI uses those.
WEB_PORT=8080

# --- Strava (optional) ---
# Create an app at https://www.strava.com/settings/api
# Authorization callback domain = your PUBLIC_BASE_URL host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- LLM analysis (optional; can also be set per-user in the UI) ---
# LLM_PROVIDER: none | anthropic | openai | gemini | ollama
LLM_PROVIDER=none
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Week boundary for the "This week" tile and weekly-volume chart: monday | sunday
WEEK_STARTS_ON=monday

# --- Sync schedule (UTC hours) ---
SYNC_HOUR_UTC=3
FORECAST_HOUR_UTC=5

# --- Cloudflare Tunnel (REQUIRED for internet access) ---
# Zero Trust dashboard -> Networks -> Tunnels -> create -> copy the token.
TUNNEL_TOKEN=
